{
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "format:check": "prettier index.html style.css app.js eslint.config.mjs package.json --check"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,json,mjs}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.10"
  }
}
